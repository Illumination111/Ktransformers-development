# Qwen3.5-122B-A10B image-SFT LoRA smoke-test template.
# Render through ../render_train_config.py; do not run this file directly.

### model
model_name_or_path: __MODEL_PATH__
trust_remote_code: true
image_max_pixels: 262144
video_max_pixels: 16384

### method
stage: sft
do_train: true
finetuning_type: lora
lora_rank: 8
lora_alpha: 16
lora_dropout: 0.05
lora_target: all
# text: language LoRA; vision: vision tower + projector LoRA; all: both.
vlm_lora_scope: __LORA_SCOPE__

### dataset
dataset: __DATASET_NAME__
dataset_dir: __DATASET_DIR__
template: qwen3_5
cutoff_len: __CUTOFF_LEN__
max_samples: 6
packing: false
overwrite_cache: true
preprocessing_num_workers: 4
dataloader_num_workers: 1

### output
output_dir: __OUTPUT_DIR__
logging_steps: 1
save_strategy: "no"
plot_loss: false
overwrite_output_dir: true
save_only_model: true
report_to: none

### train
per_device_train_batch_size: 1
gradient_accumulation_steps: 1
learning_rate: 1.0e-4
max_steps: __MAX_STEPS__
num_train_epochs: 100.0
lr_scheduler_type: constant
warmup_steps: 0
bf16: true
fp16: false
gradient_checkpointing: true
gradient_checkpointing_kwargs: {use_reentrant: false}
ddp_timeout: 360000000
resume_from_checkpoint: null
max_grad_norm: 1.0

### KTransformers
use_kt: true
# Native-BF16 checkpoints are read from model_name_or_path. Do not point
# kt_weight_path at an unconverted directory merely to duplicate this value.
