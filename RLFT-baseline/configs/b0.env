# shellcheck shell=bash

b0_config_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
B0_ROOT=$(cd -- "$b0_config_dir/.." && pwd)
B0_WORKTREE="$B0_ROOT/worktree"
B0_CONDA_ENV=kt-rflt-baseline
B0_CONDA_PREFIX=/home/wubowen/miniconda3/envs/kt-rflt-baseline
B0_PYTORCH_VERSION=2.8.0
B0_TRANSFORMERS_VERSION=4.57.6
B0_PEFT_VERSION=0.19.1
B0_SGL_KERNEL_VERSION=0.3.18
B0_MATH_VERIFY_VERSION=0.9.0
B0_MODEL=/mnt/qjh007/models/Qwen3-30B-A3B-Instruct-2507
B0_MATH_MODEL=/mnt/qjh007/models/Qwen3-30B-A3B-Instruct-2507
B0_COMMIT=68e9571a9eaa20ee44954567f507a92c986e9db0

B0_TRAIN_DATA="$B0_ROOT/data/processed/train.parquet"
B0_VAL_DATA="$B0_ROOT/data/processed/validation.parquet"
B0_MATH500_DATA="$B0_ROOT/data/processed/math500.parquet"
B0_AIME2024_DATA="$B0_ROOT/data/processed/aime2024.parquet"
B0_REWARD_FUNCTION="$B0_ROOT/scripts/nekoqa_reward.py"

B0_SEED=42
B0_CUDA_VISIBLE_DEVICES=0,1
B0_NGPUS=2
B0_PROJECT=qwen3_30b_a3b_verl_grpo_b0
B0_TRAIN_BATCH_SIZE=32
B0_PPO_MINI_BATCH_SIZE=16
B0_MAX_PROMPT_LENGTH=1024
B0_MAX_RESPONSE_LENGTH=512
B0_PPO_MAX_TOKEN_LEN_PER_GPU=8192
B0_ACTOR_LR=5e-6
B0_KL_LOSS_COEF=0.01
B0_ROLLOUT_BACKEND=sglang
B0_ROLLOUT_TP=2
# On two H20s, TP=2 keeps one native Qwen3-MoE rollout replica.  A 0.40
# static fraction leaves room for the BF16 FSDP2 actor shard and activations.
B0_ROLLOUT_GPU_MEMORY_UTILIZATION=0.40
B0_ROLLOUT_N=4
B0_LORA_RANK=32
B0_LORA_ALPHA=64
# SGLang 0.5.8 normalizes these PEFT suffixes to qkv_proj/o_proj.  The
# PEFT-only `all-linear` sentinel is not a valid SGLang target-module list.
B0_LORA_TARGET_MODULES="['q_proj','k_proj','v_proj','o_proj']"
B0_TOTAL_EPOCHS=1
B0_SAVE_FREQ=20
B0_TEST_FREQ=10

# Dataset revisions must be immutable commit hashes before prepare_data.py runs.
B0_DATASET_ID=liumindmind/NekoQA-10K
B0_DATASET_REVISION=1b2110c996a8237823b86c1a3d3e8a6762b38430
B0_DATASET_SPLIT=train
B0_MATH500_REVISION=6e4ed1a2a79af7d8630a6b768ec859cb5af4d3be
B0_AIME2024_REVISION=aa49075e24ad594b79fdf0bdcefa735c2181be67
B0_DAPO_MATH_ID=BytedTsinghua-SIA/DAPO-Math-17k
B0_DAPO_MATH_REVISION=65877096c24ffa7abc4e4fa5edb95cf3413a5674
B0_HARD_MATH_TRAIN_DATA="$B0_ROOT/data/processed/math_grpo_v2/train.parquet"
B0_MATH_VALIDATION_GATE_DATA="$B0_ROOT/data/processed/math_grpo_v2/validation_gate.parquet"
B0_MATH_REWARD_FUNCTION="$B0_ROOT/scripts/math_verify_reward.py"
